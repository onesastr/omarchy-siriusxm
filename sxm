# Client side


def offline_status():
    user = user_state()
    return {
        "daemon": False, "running": False, "state": "stopped", "channel": None,
        "track": describe_cut(None), "volume": user["volume"], "muted": False,
        "error": "", "loggedIn": Keyring.load() is not None, "last": user["last"],
    }


def daemon_info():
    info = read_json(DAEMON_FILE)
    if not info or not info.get("port") or not info.get("token"):
        return None
    return info


def send(info, request, timeout=30):
    url = f"http://127.0.0.1:{info['port']}/{info['token']}/cmd"
    body = json.dumps(request).encode()
    req = urllib.request.Request(url, data=body, method="POST", headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        try:
            payload = json.loads(error.read() or b"{}")
        except ValueError:
            payload = {}
        raise (AuthError if payload.get("auth") else SxmError)(payload.get("error") or f"daemon returned {error.code}") from None


def ping(info):
    try:
        return send(info, {"cmd": "ping"}, timeout=2).get("ok") is True
    except (SxmError, OSError, ValueError):
        return False


def ensure_daemon():
    ensure_dirs()
    info = daemon_info()
    if info and ping(info):
        return info
    with open(SPAWN_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        info = daemon_info()
        if info and ping(info):
            return info
        try:
            os.unlink(DAEMON_FILE)
        except FileNotFoundError:
            pass
        with open(DAEMON_LOG, "a") as log_handle:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "daemon"],
                             stdin=subprocess.DEVNULL, stdout=log_handle, stderr=log_handle,
                             start_new_session=True, close_fds=True)
        for _ in range(100):
            time.sleep(0.05)
            info = daemon_info()
            if info and ping(info):
                return info
    raise SxmError("Could not start the sxm daemon; see " + DAEMON_LOG)


def run_command(request, timeout=45):
    return send(ensure_daemon(), request, timeout=timeout)


def print_json(value):
    print(json.dumps(value, ensure_ascii=False, indent=2))


def cmd_login(args):
    if args.stdin:
        try:
            data = json.loads(sys.stdin.readline())
        except ValueError:
            raise SxmError("Expected JSON {\"username\": ..., \"password\": ...} on stdin") from None
        username, password = str(data.get("username", "")).strip(), str(data.get("password", ""))
    else:
        username = input("SiriusXM email: ").strip()
        password = getpass.getpass("SiriusXM password: ")
    if not username or not password:
        raise SxmError("Email and password are both required")
    ensure_dirs()
    api = SxmApi(creds=lambda: {"username": username, "password": password})
    api.reset(keep_device=True)
    api.login()
    Keyring.store(username, password)
    info = daemon_info()
    if info and ping(info):
        send(info, {"cmd": "relogin"})
    write_json(STATUS_FILE, dict(read_json(STATUS_FILE, {}) or offline_status(), loggedIn=True, error=""), mode=0o644)
    print("Signed in to SiriusXM as", username)


def cmd_logout(_args):
    info = daemon_info()
    if info and ping(info):
        send(info, {"cmd": "quit"})
    Keyring.clear()
    for path in (SESSION_FILE,):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    write_json(STATUS_FILE, dict(offline_status(), loggedIn=False), mode=0o644)
    print("Signed out")


def cmd_status(args):
    info = daemon_info()
    status = send(info, {"cmd": "status"}, timeout=5) if info and ping(info) else None
    if status is None:
        ensure_dirs()
        status = offline_status()
        write_json(STATUS_FILE, status, mode=0o644)
    if args.json:
        print_json(status)
        return
    channel = status.get("channel") or {}
    track = status.get("track") or {}
    print(f"state:   {status['state']}" + (f" ({status['error']})" if status.get("error") else ""))
    if channel:
        print(f"channel: {channel.get('number') or ''} {channel.get('name')}".rstrip())
    if track.get("title"):
        print(f"track:   {track.get('artist')} — {track.get('title')}")
    print(f"volume:  {status.get('volume')}%")
    print(f"login:   {'yes' if status.get('loggedIn') else 'no'}")


def cmd_channels(args):
    channels = run_command({"cmd": "channels", "refresh": args.refresh}, timeout=60)["channels"]
    if args.json:
        print_json(channels)
        return
    favorites = set(user_state()["favorites"])
    for channel in channels:
        star = "★" if channel["id"] in favorites else " "
        number = channel["number"] if channel["number"] is not None else "-"
        print(f"{star} {number:>4}  {channel['name']:<32}  {channel['category']}")


def cmd_fav(args):
    channels = read_json(LINEUP_FILE, {}).get("channels") or []
    target = next((c for c in channels if args.channel in (c["id"], str(c["number"]))), None)
    channel_id = target["id"] if target else args.channel
    favorites = user_state()["favorites"]
    if channel_id in favorites:
        favorites.remove(channel_id)
        added = False
    else:
        favorites.append(channel_id)
        added = True
    update_user_state(favorites=favorites)
    print(("Added " if added else "Removed ") + (target["name"] if target else channel_id))


def main(argv=None):
    parser = argparse.ArgumentParser(prog="sxm", description="SiriusXM for Omarchy")
    sub = parser.add_subparsers(dest="command", required=True)
    login = sub.add_parser("login", help="sign in and store credentials in the keyring")
    login.add_argument("--stdin", action="store_true", help="read JSON credentials from stdin")
    sub.add_parser("logout", help="forget credentials and stop playback")
    status = sub.add_parser("status", help="show playback status")
    status.add_argument("--json", action="store_true")
    channels = sub.add_parser("channels", help="list channels")
    channels.add_argument("--refresh", action="store_true")
    channels.add_argument("--json", action="store_true")
    play = sub.add_parser("play", help="play a channel by number, name or id")
    play.add_argument("channel", nargs="+")
    for name, text in (("stop", "stop playback"), ("toggle", "play/pause"),
                       ("next", "next channel"), ("prev", "previous channel")):
        sub.add_parser(name, help=text)
    volume = sub.add_parser("volume", help="set volume: 0-100, +5 or -5")
    volume.add_argument("value")
    fav = sub.add_parser("fav", help="toggle a favorite channel")
    fav.add_argument("channel")
    raw = sub.add_parser("raw", help="dump raw API responses for debugging")
    raw.add_argument("what", choices=["lineup", "tune", "live"])
    raw.add_argument("channel", nargs="?", default="")
    widget = sub.add_parser("widget", help=argparse.SUPPRESS)
    widget.add_argument("state", choices=["alive", "gone"])
    sub.add_parser("daemon", help="run the proxy daemon in the foreground")
    sub.add_parser("quit", help="stop the daemon")
    args = parser.parse_args(argv)

    try:
        if args.command == "login":
            cmd_login(args)
        elif args.command == "logout":
            cmd_logout(args)
        elif args.command == "status":
            cmd_status(args)
        elif args.command == "channels":
            cmd_channels(args)
        elif args.command == "fav":
            ensure_dirs()
            cmd_fav(args)
        elif args.command == "play":
            channel = run_command({"cmd": "play", "id": " ".join(args.channel)})["channel"]
            print("Playing", channel["name"])
        elif args.command in ("stop", "toggle", "next", "prev"):
            run_command({"cmd": args.command})
        elif args.command == "volume":
            print(run_command({"cmd": "volume", "value": args.value})["volume"])
        elif args.command == "raw":
            print_json(run_command({"cmd": "raw", "what": args.what, "id": args.channel}, timeout=60))
        elif args.command == "widget":
            info = daemon_info()  # never starts the daemon
            if info and ping(info):
                send(info, {"cmd": "widget", "state": args.state}, timeout=5)
        elif args.command == "daemon":
            Daemon().serve()
        elif args.command == "quit":
            info = daemon_info()
            if info and ping(info):
                send(info, {"cmd": "quit"})
    except AuthError as error:
        print(f"sxm: {error}", file=sys.stderr)
        return 3
    except SxmError as error:
        print(f"sxm: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
