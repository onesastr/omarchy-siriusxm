class SxmError(Exception):
    """An error with a message fit to show the user."""


class AuthError(SxmError):
    pass


class ApiError(SxmError):
    def __init__(self, status, path, body=b""):
        self.status = status
        self.path = path
        self.body = body
        snippet = body[:300].decode("utf-8", "replace") if body else ""
        super().__init__(f"SiriusXM API {path} returned {status} {snippet}".strip())


def log(*parts):
    stamp = time.strftime("%H:%M:%S")
    print(stamp, *parts, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Small helpers


def ensure_dirs():
    for path in (RUNTIME_DIR, STATE_DIR, DATA_DIR, CACHE_DIR):
        os.makedirs(path, mode=0o700, exist_ok=True)


def read_json(path, fallback=None):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_json(path, value, mode=0o600):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    temporary = f"{path}.{os.getpid()}.{threading.get_ident()}.tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(value, handle, ensure_ascii=False, separators=(",", ":"))
    os.replace(temporary, path)


def dig(value, *keys):
    for key in keys:
        if isinstance(value, dict):
            value = value.get(key)
        elif isinstance(value, list) and isinstance(key, int) and -len(value) <= key < len(value):
            value = value[key]
        else:
            return None
    return value


def parse_time(value):
    """Parse SiriusXM timestamps, including the '+00:00Z' form, to epoch seconds."""
    if isinstance(value, (int, float)):
        return value / 1000 if value > 1e11 else float(value)
    if not isinstance(value, str) or not value:
        return None
    text = value.strip().replace("+00:00Z", "Z")
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        stamp = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=dt.timezone.utc)
    return stamp.timestamp()


def iso_utc(epoch):
    stamp = dt.datetime.fromtimestamp(epoch, dt.timezone.utc)
    return stamp.strftime("%Y-%m-%dT%H:%M:%S.") + f"{stamp.microsecond // 1000:03d}Z"


def image_url(key, size=300):
    """Turn a SiriusXM image key (or URL) into a fetchable URL."""
    if not key or not isinstance(key, str):
        return ""
    if key.startswith("http://") or key.startswith("https://"):
        return key
    params = {"key": key, "edits": [{"format": {"type": "jpeg"}},
                                    {"resize": {"width": size, "height": size}}]}
    encoded = base64.b64encode(json.dumps(params, separators=(",", ":")).encode()).decode()
    return IMG_BASE + encoded


def pick_image(images, size=300):
    for kind in ("tile", "logo"):
        for aspect in ("aspect_1x1", "aspect_16x9"):
            for variant in ("preferred", "preferredImage", "default", "defaultImage"):
                url = dig(images, kind, aspect, variant, "url")
                if url:
                    return image_url(url, size)
    return ""


def http_request(method, url, headers=None, body=None, timeout=20):
    request = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, response.headers, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.headers, error.read() if error.fp else b""
    except (urllib.error.URLError, socket.timeout, ConnectionError) as error:
        reason = getattr(error, "reason", error)
        raise SxmError(f"Network error reaching {urllib.parse.urlsplit(url).netloc}: {reason}") from None


# --------------------------------------------------------------------------
# Credentials (GNOME Keyring / libsecret via secret-tool)


class Keyring:
    ATTRS = ["service", APP, "account", "default"]

    @staticmethod
    def available():
        return shutil.which("secret-tool") is not None

    @classmethod
    def load(cls):
        if not cls.available():
            return None
        result = subprocess.run(["secret-tool", "lookup", *cls.ATTRS],
                                capture_output=True, text=True, timeout=10)
        if result.returncode != 0 or not result.stdout.strip():
            return None
        try:
            creds = json.loads(result.stdout)
        except ValueError:
            return None
        if creds.get("username") and creds.get("password"):
            return creds
        return None

    @classmethod
    def store(cls, username, password):
        if not cls.available():
            raise SxmError("secret-tool is missing; install libsecret")
        secret = json.dumps({"username": username, "password": password})
        result = subprocess.run(["secret-tool", "store", "--label", "SiriusXM (Omarchy)", *cls.ATTRS],
                                input=secret, capture_output=True, text=True, timeout=30)
        if result.returncode != 0:
            raise SxmError("Could not save to the keyring: " + (result.stderr.strip() or "unknown error"))

    @classmethod
    def clear(cls):
        if cls.available():
            subprocess.run(["secret-tool", "clear", *cls.ATTRS], capture_output=True, timeout=10)


# --------------------------------------------------------------------------
# SiriusXM edge-gateway API


class SxmApi:
    """Token lifecycle: device grant -> anonymous session -> identity grant -> authenticated session."""

    def __init__(self, session_file=SESSION_FILE, creds=Keyring.load):
        self.session_file = session_file
        self.creds = creds
        self.lock = threading.RLock()
        self.clock = 0
        self.state = read_json(session_file, {}) or {}

    # -- token bookkeeping

    def _save(self):
        write_json(self.session_file, self.state)

    def _valid(self, token_key, expiry_key):
        token = self.state.get(token_key)
        expiry = self.state.get(expiry_key) or 0
        return bool(token) and expiry - time.time() > TOKEN_MARGIN

    def _bearer(self):
        if self._valid("access_token", "access_expires"):
            return self.state["access_token"]
        if self.state.get("identity_grant") and self._valid("anon_token", "anon_expires"):
            return self.state["identity_grant"]
        if self._valid("anon_token", "anon_expires"):
            return self.state["anon_token"]
        return self.state.get("device_grant")

    def reset(self, keep_device=True):
        with self.lock:
            device = {k: self.state[k] for k in ("device_id", "device_grant") if k in self.state}
            self.state = device if keep_device else {}
            self._save()

    # -- raw requests

    def _request(self, method, path, payload=None, query=None, bearer=True):
        url = API_BASE + path
        if query:
            url += "?" + urllib.parse.urlencode(query)
        with self.lock:
            self.clock += 1
            clock = self.clock
            token = self._bearer() if bearer else None
        headers = {
            "Accept": "application/json",
            "User-Agent": USER_AGENT,
            "Origin": WEB_ORIGIN,
            "Referer": WEB_ORIGIN + "/",
            "x-sxm-clock": f"[0,{clock}]",
            "x-sxm-platform": "browser",
            "x-sxm-tenant": "sxm",
        }
        if token:
            headers["Authorization"] = "Bearer " + token
        body = None
        if payload is not None:
            headers["Content-Type"] = "application/json; charset=UTF-8"
            body = json.dumps(payload).encode()
        status, _, data = http_request(method, url, headers, body)
        if status < 200 or status >= 300:
            raise ApiError(status, path, data)
        if not data:
            return {}
        try:
            return json.loads(data)
        except ValueError:
            raise ApiError(status, path, b"invalid JSON: " + data[:200]) from None

    # -- login

    def login(self):
        """Bring the session up to an authenticated access token."""
        with self.lock:
            if self._valid("access_token", "access_expires"):
                return
            creds = self.creds()
            if not creds:
                raise AuthError("Not signed in. Run `sxm login` or sign in from the panel.")

            if not self.state.get("device_grant"):
                device = self._request("POST", "device/v1/devices", {
                    "devicePlatform": "web-desktop",
                    "deviceAttributes": {"browser": {
                        "browserVersion": "130.0.0.0", "browser": "Chrome", "userAgent": USER_AGENT,
                        "sdk": "web", "app": "web", "sdkVersion": "130.0.0.0", "appVersion": "130.0.0.0",
                    }},
                }, bearer=False)
                if not device.get("grant"):
                    raise SxmError("SiriusXM did not issue a device grant")
                self.state = {"device_id": device.get("deviceId"), "device_grant": device["grant"]}
                self._save()

            if not (self.state.get("identity_grant") and self._valid("anon_token", "anon_expires")):
                self.state.pop("access_token", None)
                self.state.pop("identity_grant", None)
                self.state.pop("anon_token", None)
                anon = self._request("POST", "session/v1/sessions/anonymous", "")
                self.state["anon_token"] = anon.get("accessToken")
                self.state["anon_expires"] = parse_time(anon.get("accessTokenExpiresAt")) or time.time() + 3600
                try:
                    identity = self._request("POST", "identity/v1/identities/authenticate/password",
                                             {"handle": creds["username"], "password": creds["password"]})
                except ApiError as error:
                    if error.status in (400, 401, 403, 404, 422):
                        raise AuthError("SiriusXM rejected that email or password") from None
                    raise
                if not identity.get("grant"):
                    raise AuthError("SiriusXM did not accept the login")
                self.state["identity_grant"] = identity["grant"]
                self._save()

            session = self._request("POST", "session/v1/sessions/authenticated", "")
            if not session.get("accessToken"):
                raise AuthError("SiriusXM did not open an authenticated session")
            self.state["access_token"] = session["accessToken"]
            self.state["access_expires"] = parse_time(session.get("accessTokenExpiresAt")) or time.time() + 3600
            self._save()

    def call(self, method, path, payload=None, query=None):
        """Authenticated request with one re-login on 401/403."""
        self.login()
        try:
            return self._request(method, path, payload, query)
        except ApiError as error:
            if error.status not in (401, 403):
                raise
            log(f"{path} -> {error.status}; re-authenticating")
            self.reset(keep_device=True)
            self.login()
            return self._request(method, path, payload, query)

    # -- endpoints

    def lineup(self):
        query = dict(LINEUP_QUERY, key=base64.b64encode(str(uuid.uuid4()).encode()).decode())
        return self.call("GET", "relationship/v1/container/all-channels", query=query)

    def tune(self, channel_id, entity_type):
        return self.call("POST", "playback/play/v1/tuneSource", {
            "id": channel_id,
            "type": entity_type or "channel-linear",
            "hlsVersion": "V3",
            "manifestVariant": "WEB" if (entity_type or "channel-linear") == "channel-linear" else "FULL",
            "mtcVersion": "V2",
        })

    def key(self, guid):
        data = self.call("GET", f"playback/key/v1/{guid}")
        raw = base64.b64decode(data.get("key") or "")
        if len(raw) != 16:
            raise SxmError(f"Unexpected key length {len(raw)} for {guid}")
        return raw

    def live_update(self, channel_id):
        now = time.time()
        return self.call("POST", "playback/play/v1/liveUpdate", {
            "channelId": channel_id,
            "startTimestamp": iso_utc(now - 3 * 3600),
            "endTimestamp": iso_utc(now + 60),
        })


