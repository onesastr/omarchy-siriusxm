# Pure transforms (unit tested)


def normalize_channel(item):
    entity = item.get("entity") or {}
    decorations = item.get("decorations") or {}
    texts = entity.get("texts") or {}

    def text(name):
        value = texts.get(name)
        if isinstance(value, dict):
            value = value.get("default") or next((v for v in value.values() if isinstance(v, str)), "")
        return value if isinstance(value, str) else ""

    number = decorations.get("channelNumber")
    try:
        number = int(number)
    except (TypeError, ValueError):
        number = None
    category = decorations.get("genre") or ""
    if not category:
        tags = decorations.get("contentTags") or []
        category = tags[0] if tags and isinstance(tags[0], str) else ""
    return {
        "id": entity.get("id") or "",
        "type": entity.get("type") or "channel-linear",
        "name": text("title") or text("name") or entity.get("id") or "",
        "description": text("description") or text("shortDescription"),
        "number": number,
        "category": category if isinstance(category, str) else "",
        "logo": pick_image(entity.get("images") or {}, 160),
        "color": dig(decorations, "hexcode", "default") or "",
        "locked": decorations.get("unentitled") is True,
    }


def normalize_lineup(raw):
    items = []
    for group in dig(raw, "container", "sets") or []:
        items.extend(group.get("items") or [])
    seen = set()
    channels = []
    for item in items:
        channel = normalize_channel(item)
        if channel["id"] and channel["id"] not in seen:
            seen.add(channel["id"])
            channels.append(channel)
    channels.sort(key=lambda c: (c["number"] is None, c["number"] or 0, c["name"].lower()))
    return channels


def select_variant(master_text, master_url):
    """Return the absolute URL of the highest-bandwidth variant in a master playlist."""
    lines = [line.strip() for line in master_text.splitlines()]
    best, best_bw = None, -1
    for index, line in enumerate(lines):
        if not line.startswith("#EXT-X-STREAM-INF"):
            continue
        match = re.search(r"(?:^|[:,])BANDWIDTH=(\d+)", line)
        bandwidth = int(match.group(1)) if match else 0
        uri = next((l for l in lines[index + 1:] if l and not l.startswith("#")), None)
        if uri and bandwidth > best_bw:
            best, best_bw = uri, bandwidth
    if best is None:
        if any(l.startswith("#EXTINF") for l in lines):
            return master_url  # already a media playlist
        best = next((l for l in lines if l and not l.startswith("#") and ".m3u8" in l), None)
    if best is None:
        raise SxmError("Master playlist has no variants")
    return urllib.parse.urljoin(master_url, best)


def rewrite_playlist(text, base_url, prefix):
    """Rewrite a live media playlist so keys and segments go through the local proxy.

    Returns (playlist_text, {absolute_segment_url: segment_end_epoch_or_None}).
    """
    out, segments = [], {}
    clock, duration = None, 0.0
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        if line.startswith("#EXT-X-ENDLIST") or line.startswith("#EXT-X-PLAYLIST-TYPE"):
            continue  # always treat as a live sliding window
        if line.startswith("#EXT-X-KEY"):
            guids = GUID_RE.findall(line)
            if guids and 'URI="' in line:
                line = re.sub(r'URI="[^"]*"', f'URI="{prefix}/key/{guids[-1]}"', line)
            out.append(line)
            continue
        if line.startswith("#EXT-X-MAP") and 'URI="' in line:
            def proxy_map(match):
                absolute = urllib.parse.urljoin(base_url, match.group(1))
                segments[absolute] = None
                return f'URI="{prefix}/seg?u={urllib.parse.quote(absolute, safe="")}"'
            out.append(re.sub(r'URI="([^"]*)"', proxy_map, line))
            continue
        if line.startswith("#EXT-X-PROGRAM-DATE-TIME:"):
            clock = parse_time(line.split(":", 1)[1])
            out.append(line)
            continue
        if line.startswith("#EXTINF:"):
            try:
                duration = float(line[8:].split(",", 1)[0])
            except ValueError:
                duration = 0.0
            out.append(line)
            continue
        if line.startswith("#"):
            out.append(line)
            continue
        absolute = urllib.parse.urljoin(base_url, line)
        if clock is not None:
            clock += duration
        segments[absolute] = clock
        out.append(f"{prefix}/seg?u={urllib.parse.quote(absolute, safe='')}")
    return "\n".join(out) + "\n", segments


def current_cut(items, position):
    """Pick the track/show playing at epoch `position` from liveUpdate items."""
    cuts = []
    for item in items or []:
        start = parse_time(item.get("timestamp") or item.get("startTime"))
        if start is None:
            continue
        length = item.get("duration") or 0
        try:
            length = float(length) / 1000.0
        except (TypeError, ValueError):
            length = 0.0
        cuts.append((start, start + length, item))
    if not cuts:
        return None
    cuts.sort(key=lambda c: c[0])
    playing = [c for c in cuts if c[0] <= position <= c[1] + 1]
    if playing:
        return playing[-1][2]
    started = [c for c in cuts if c[0] <= position]
    return (started[-1] if started else cuts[0])[2]


def volume_level(ao_volume):
    """mpv ao-volume -> the 0-100 level Omarchy's audio panel displays."""
    return max(0, min(100, round(float(ao_volume))))


def describe_cut(item):
    if not item:
        return {"artist": "", "title": "", "album": "", "art": "", "interstitial": False}
    return {
        "artist": item.get("artistName") or "",
        "title": item.get("name") or "",
        "album": item.get("albumName") or "",
        "art": pick_image(item.get("images") or {}, 300) or pick_image(item.get("artistImages") or {}, 300),
        "interstitial": bool(item.get("isInterstitial")),
    }


# --------------------------------------------------------------------------
# User state (favorites, volume, last channel) — shared by CLI and daemon


def user_state():
    state = read_json(USER_FILE, {}) or {}
    favorites = state.get("favorites")
    state["favorites"] = [f for f in favorites if isinstance(f, str)] if isinstance(favorites, list) else []
    volume = state.get("volume")
    state["volume"] = int(volume) if isinstance(volume, (int, float)) and 0 <= volume <= 130 else DEFAULT_VOLUME
    if not isinstance(state.get("last"), str):
        state["last"] = ""
    return state


def update_user_state(**changes):
    with open(os.path.join(DATA_DIR, ".lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = user_state()
        state.update(changes)
        write_json(USER_FILE, state)
        return state


# --------------------------------------------------------------------------
# mpv control over JSON IPC


def kill_strays(keep=None):
    """Terminate mpv processes left behind on our IPC socket by an earlier daemon."""
    marker = f"--input-ipc-server={MPV_SOCKET}".encode()
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == keep:
            continue
        try:
            with open(f"/proc/{entry}/cmdline", "rb") as handle:
                argv = handle.read().split(b"\0")
        except OSError:
            continue
        if argv and os.path.basename(argv[0]) == b"mpv" and marker in argv:
            try:
                os.kill(int(entry), signal.SIGTERM)
                log(f"killed stray mpv {entry}")
            except OSError:
                pass


class Mpv:
    OBSERVED = ["pause", "ao-volume", "ao-mute", "path", "idle-active", "demuxer-cache-duration"]

    def __init__(self, on_change):
        self.on_change = on_change
        self.proc = None
        self.sock = None
        self.lock = threading.Lock()
        self.pending = {}
        self.next_id = 0
        self.props = {}
        self.start_lock = threading.Lock()

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self, volume):
        with self.start_lock:  # concurrent play requests must not spawn several mpvs
            self._start(volume)

    def _start(self, volume):
        if self.alive():
            return
        if not shutil.which("mpv"):
            raise SxmError("mpv is not installed")
        kill_strays()
        try:
            os.unlink(MPV_SOCKET)
        except FileNotFoundError:
            pass
        self.props = {}
        mpv_log = open(os.path.join(RUNTIME_DIR, "mpv.log"), "w")
        self.proc = subprocess.Popen([
            "mpv", "--no-video", "--idle=yes", "--no-terminal", "--force-window=no",
            f"--input-ipc-server={MPV_SOCKET}", "--volume=100",
            "--audio-client-name=SiriusXM", "--title=SiriusXM",
            "--cache=yes", "--cache-secs=30", "--loop-playlist=inf",
            *os.environ.get("SXM_MPV_ARGS", "").split(),
        ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=mpv_log, start_new_session=True)
        mpv_log.close()
        for _ in range(100):
            if os.path.exists(MPV_SOCKET):
                try:
                    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    sock.connect(MPV_SOCKET)
                    self.sock = sock
                    break
                except OSError:
                    sock.close()
            if not self.alive():
                break
            time.sleep(0.05)
        if self.sock is None:
            self.quit()
            raise SxmError("mpv failed to start; see " + os.path.join(RUNTIME_DIR, "mpv.log"))
        threading.Thread(target=self._reader, args=(self.sock,), daemon=True).start()
        for index, name in enumerate(self.OBSERVED, 1):
            self._send({"command": ["observe_property", index, name]})

    def _send(self, message):
        data = (json.dumps(message) + "\n").encode()
        with self.lock:
            if self.sock is None:
                raise SxmError("mpv is not running")
            self.sock.sendall(data)

    def command(self, *args, timeout=5):
        with self.lock:
            self.next_id += 1
            request_id = self.next_id
            waiter = self.pending[request_id] = [threading.Event(), None]
        self._send({"command": list(args), "request_id": request_id})
        if not waiter[0].wait(timeout):
            self.pending.pop(request_id, None)
            raise SxmError(f"mpv did not answer {args[0]}")
        reply = waiter[1] or {}
        if reply.get("error") not in (None, "success"):
            raise SxmError(f"mpv {args[0]}: {reply.get('error')}")
        return reply.get("data")

    def _reader(self, sock):
        buffer = b""
        while True:
            try:
                chunk = sock.recv(65536)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                if "request_id" in message and message["request_id"] in self.pending:
                    waiter = self.pending.pop(message["request_id"])
                    waiter[1] = message
                    waiter[0].set()
                elif message.get("event") == "property-change":
                    self.props[message.get("name")] = message.get("data")
                    self.on_change(message.get("name"))
                elif message.get("event") in ("end-file", "file-loaded", "start-file"):
                    self.props["last-event"] = message
                    self.on_change(message.get("event"))
        with self.lock:
            if self.sock is sock:
                self.sock = None
        self.on_change("exit")

    def quit(self):
        if self.alive():
            try:
                self._send({"command": ["quit"]})
                self.proc.wait(timeout=3)
            except (SxmError, OSError, subprocess.TimeoutExpired):
                self.proc.kill()
        with self.lock:
            if self.sock is not None:
                self.sock.close()
                self.sock = None
        self.proc = None
        self.props = {}


# --------------------------------------------------------------------------
# The daemon


def serialized(method):
    def wrapper(self, *args, **kwargs):
        with self.player_lock:
            return method(self, *args, **kwargs)
    return wrapper


class Daemon:
    def __init__(self):
        self.api = SxmApi()
        self.token = secrets.token_urlsafe(18)
        self.port = 0
        self.lineup = []
        self.lineup_lock = threading.Lock()
        self.streams = {}            # channel id -> {"variant": url, "tuned": epoch}
        self.stream_lock = threading.Lock()
        self.keys = {}
        self.segments = collections.OrderedDict()   # allowed upstream URL -> PDT epoch
        self.segment_lock = threading.Lock()
        self.cuts = {}               # channel id -> {"items": [...], "fetched": epoch}
        self.last_segment = None     # (channel id, segment end epoch)
        self.logged_in = Keyring.load() is not None
        self.retuned_at = 0
        self.halting = False         # ignore mpv's own auto-advance after a failure
        self.ao_ready = False        # mpv has reported its audio-output volume
        self.volume_lock = threading.Lock()
        self.player_lock = threading.RLock()
        self.widget_alive_at = 0.0   # bar widget presence, see watch_volume
        self.widget_gone_at = 0.0
        self.volume_set_at = 0.0
        self.mpv = Mpv(self._mpv_changed)
        self.channel_id = ""
        self.track = describe_cut(None)
        self.error = ""
        self.loading = False
        self.last_activity = time.time()
        self.status_lock = threading.Lock()
        self.last_status = None
        self.shutdown = threading.Event()

    # -- lineup

    def channels(self, refresh=False):
        with self.lineup_lock:
            if self.lineup and not refresh:
                return self.lineup
            cached = read_json(LINEUP_FILE, {}) or {}
            fresh = time.time() - (cached.get("updated") or 0) < LINEUP_MAX_AGE
            if cached.get("channels") and fresh and not refresh:
                self.lineup = cached["channels"]
                return self.lineup
            try:
                raw = self.api.lineup()
            except SxmError:
                if cached.get("channels"):
                    self.lineup = cached["channels"]
                    return self.lineup
                raise
            write_json(LINEUP_RAW_FILE, raw)
            channels = normalize_lineup(raw)
            if not channels:
                raise SxmError("SiriusXM returned an empty channel lineup; see " + LINEUP_RAW_FILE)
            write_json(LINEUP_FILE, {"updated": int(time.time()), "channels": channels}, mode=0o644)
            self.lineup = channels
            return channels

    def find_channel(self, query):
        channels = self.channels()
        query = str(query).strip()
        lowered = query.lower()
        for channel in channels:
            if channel["id"] == query:
                return channel
        if query.isdigit():
            for channel in channels:
                if channel["number"] == int(query):
                    return channel
        for channel in channels:
            if channel["name"].lower() == lowered:
                return channel
        matches = [c for c in channels if lowered in c["name"].lower()]
        if len(matches) == 1:
            return matches[0]
        if matches:
            raise SxmError(f"'{query}' matches {len(matches)} channels: "
                           + ", ".join(c["name"] for c in matches[:6]))
        raise SxmError(f"No channel matches '{query}'")

    # -- streaming

    def prefix(self):
        return f"http://127.0.0.1:{self.port}/{self.token}"

    def _variant_url(self, channel, force=False):
        with self.stream_lock:
            cached = self.streams.get(channel["id"])
            if cached and not force and time.time() - cached["tuned"] < STREAM_MAX_AGE:
                return cached["variant"]
        tuned = self.api.tune(channel["id"], channel["type"])
        stream = (tuned.get("streams") or [{}])[0]
        urls = stream.get("urls") or []
        choice = next((u for u in urls if u.get("isPrimary")), urls[0] if urls else None)
        if not choice or not choice.get("url"):
            raise SxmError(f"No stream URL for {channel['name']}")
        live_items = dig(stream, "metadata", "live", "items")
        if live_items:
            self.cuts[channel["id"]] = {"items": live_items, "fetched": time.time()}
        status, _, body = http_request("GET", choice["url"], {"User-Agent": USER_AGENT})
        if status != 200:
            raise SxmError(f"Master playlist returned {status}")
        variant = select_variant(body.decode("utf-8", "replace"), choice["url"])
        with self.stream_lock:
            self.streams[channel["id"]] = {"variant": variant, "tuned": time.time()}
        return variant

    def playlist(self, channel_id):
        channel = next((c for c in self.channels() if c["id"] == channel_id), None)
        if channel is None:
            raise SxmError(f"Unknown channel {channel_id}")
        for attempt in range(2):
            variant = self._variant_url(channel, force=attempt > 0)
            status, _, body = http_request("GET", variant, {"User-Agent": USER_AGENT})
            if status == 200:
                break
            log(f"variant playlist {status} for {channel['name']}; re-tuning")
        else:
            raise SxmError(f"Stream for {channel['name']} is unavailable ({status})")
        text, segments = rewrite_playlist(body.decode("utf-8", "replace"), variant, self.prefix())
        with self.segment_lock:
            for url, pdt in segments.items():
                self.segments[url] = (channel_id, pdt)
                self.segments.move_to_end(url)
            while len(self.segments) > 4000:
                self.segments.popitem(last=False)
        return text

    def key(self, guid):
        if guid not in self.keys:
            self.keys[guid] = self.api.key(guid)
        return self.keys[guid]

    def segment_allowed(self, url):
        with self.segment_lock:
            return self.segments.get(url, False)

    def note_segment(self, entry):
        channel_id, end = entry
        if end is not None:
            self.last_segment = (channel_id, end)

    # -- now playing

    def playback_position(self):
        """Best estimate of the wall-clock time of the audio being heard."""
        if self.last_segment and self.last_segment[0] == self.channel_id:
            buffered = self.mpv.props.get("demuxer-cache-duration")
            buffered = float(buffered) if isinstance(buffered, (int, float)) else 10.0
            return self.last_segment[1] - buffered
        return time.time() - 30

    def refresh_now_playing(self):
        channel_id = self.channel_id
        if not channel_id or not self.mpv.alive():
            return
        cached = self.cuts.get(channel_id)
        position = self.playback_position()
        cut = current_cut(cached["items"], position) if cached else None
        stale = not cached or time.time() - cached["fetched"] > 180
        if cut:
            start = parse_time(cut.get("timestamp")) or 0
            end = start + float(cut.get("duration") or 0) / 1000.0
            if end and position > end + 5:
                stale = True
        if stale:
            try:
                data = self.api.live_update(channel_id)
                self.cuts[channel_id] = {"items": data.get("items") or [], "fetched": time.time()}
                cut = current_cut(self.cuts[channel_id]["items"], position)
            except SxmError as error:
                log("liveUpdate failed:", error)
        track = describe_cut(cut)
        if track != self.track:
            self.track = track
            self._push_media_title()
            self.write_status()

    def _push_media_title(self):
        channel = self.current_channel() or {}
        if self.track["title"] and not self.track["interstitial"]:
            title = " — ".join(p for p in (self.track["artist"], self.track["title"]) if p)
        else:
            title = channel.get("name") or "SiriusXM"
        try:
            if self.mpv.alive():
                self.mpv.command("set_property", "force-media-title", title)
        except SxmError:
            pass

    def current_channel(self):
        return next((c for c in self.lineup if c["id"] == self.channel_id), None)

    # -- player commands

    @serialized
    def play(self, query):
        self.api.login()  # fail fast with a clear message instead of a dead stream
        channel = self.find_channel(query)
        state = user_state()
        favorites = state["favorites"]
        ring = [c for c in self.lineup if c["id"] in favorites]
        if channel["id"] not in favorites or len(ring) < 2:
            ring = self.lineup
        index = next(i for i, c in enumerate(ring) if c["id"] == channel["id"])
        lines = ["#EXTM3U"]
        for c in ring:
            label = f"{c['number']} · {c['name']}" if c["number"] is not None else c["name"]
            lines.append(f"#EXTINF:-1,{label}")
            lines.append(f"{self.prefix()}/live/{c['id']}.m3u8")
        with open(PLAYLIST_FILE, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
        self.error = ""
        self.loading = True
        self.halting = False
        self.channel_id = channel["id"]
        self.track = describe_cut(None)
        if not self.mpv.alive():
            self.ao_ready = False
        self.mpv.start(state["volume"])
        self.mpv.command("set_property", "playlist-start", index)
        self.mpv.command("loadlist", PLAYLIST_FILE, "replace")
        self.mpv.command("set_property", "pause", False)
        update_user_state(last=channel["id"])
        self.write_status()
        threading.Thread(target=self.refresh_now_playing, daemon=True).start()
        return channel

    @serialized
    def stop(self):
        self.mpv.quit()
        self.loading = False
        self.write_status()

    @serialized
    def toggle(self):
        if not self.mpv.alive() or self.mpv.props.get("idle-active"):
            last = user_state()["last"] or (self.channels()[0]["id"] if self.channels() else "")
            if not last:
                raise SxmError("No channel to play")
            self.play(last)
            return
        self.mpv.command("cycle", "pause")

    @serialized
    def step(self, direction):
        if not self.mpv.alive():
            self.toggle()
            return
        self.mpv.command("playlist-next" if direction > 0 else "playlist-prev", "force")

    # Volume lives on the PipeWire stream (mpv's ao-volume), the same control
    # and the same linear 0-100 scale Omarchy's audio panel shows for the
    # "SiriusXM" stream, so the two never fight. mpv's own software volume
    # stays pinned at 100.

    def current_volume(self):
        linear = self.mpv.props.get("ao-volume") if self.mpv.alive() else None
        return volume_level(linear) if isinstance(linear, (int, float)) else user_state()["volume"]

    def set_volume(self, value):
        if isinstance(value, str) and value[:1] in "+-":
            target = self.current_volume() + int(value)
        else:
            target = int(value)
        target = max(0, min(100, target))
        with self.volume_lock:
            update_user_state(volume=target)
            if self.mpv.alive():
                try:
                    self.mpv.command("set_property", "ao-volume", target)
                    # Record it now: mpv reports the old level until PipeWire
                    # acknowledges, and a stale status makes the slider jump back.
                    self.mpv.props["ao-volume"] = target
                    self.volume_set_at = time.time()
                except SxmError:
                    pass  # audio output not open yet; applied when it opens
        self.write_status()
        return target

    def _apply_saved_volume(self):
        linear = user_state()["volume"]
        try:
            self.mpv.command("set_property", "ao-volume", linear)
            self.mpv.props["ao-volume"] = linear
        except SxmError:
            self.ao_ready = False
        self.write_status()

    def _halt(self):
        try:
            self.mpv.command("stop")
        except SxmError:
            pass
        self.write_status()

    def _retune(self, channel_id):
        if time.time() - self.retuned_at < 30:
            self.error = "Stream ended unexpectedly"
            self._halt()
            return
        self.retuned_at = time.time()
        with self.stream_lock:
            self.streams.pop(channel_id, None)
        try:
            self.play(channel_id)
        except SxmError as error:
            self.error = str(error)
            self.write_status()

    def _mpv_changed(self, name):
        if name == "ao-volume" and self.ao_ready and isinstance(self.mpv.props.get("ao-volume"), (int, float)):
            level = volume_level(self.mpv.props["ao-volume"])
            if level != user_state()["volume"]:
                update_user_state(volume=level)  # changed elsewhere, e.g. Omarchy's audio panel
        if name == "path":
            path = self.mpv.props.get("path") or ""
            match = re.search(r"/live/([^/]+)\.m3u8$", path)
            if self.halting:
                match = None
            if match and match.group(1) != self.channel_id:
                self.channel_id = match.group(1)
                self.track = describe_cut(None)
                update_user_state(last=self.channel_id)
                threading.Thread(target=self.refresh_now_playing, daemon=True).start()
            if match:
                threading.Thread(target=self._push_media_title, daemon=True).start()
        elif name == "start-file":
            self.loading = True
        elif name == "file-loaded":
            self.loading = False
            self.error = ""
        elif name == "end-file":
            # mpv would advance to the next channel on its own; keep the listener
            # on the channel they chose instead. Commands can't run on the reader
            # thread (it delivers their replies), so hand off to a worker.
            event = self.mpv.props.get("last-event") or {}
            reason = event.get("reason")
            if reason in ("error", "eof"):
                self.halting = True
            if reason == "error":
                self.loading = False
                self.error = "Stream failed: " + str(event.get("file_error") or "unknown error")
                threading.Thread(target=self._halt, daemon=True).start()
            elif reason == "eof" and self.channel_id:
                threading.Thread(target=self._retune, args=(self.channel_id,), daemon=True).start()
        elif name == "exit":
            self.loading = False
        if name != "demuxer-cache-duration":
            self.write_status()

    # -- status

    def status(self):
        alive = self.mpv.alive()
        props = self.mpv.props if alive else {}
        if not alive:
            state = "error" if self.error else "stopped"
        elif self.error:
            state = "error"
        elif self.loading:
            state = "loading"
        elif props.get("pause"):
            state = "paused"
        else:
            state = "playing"
        user = user_state()
        volume = props.get("ao-volume")
        return {
            "daemon": True,
            "running": alive,
            "state": state,
            "channel": self.current_channel() if alive else None,
            "track": self.track if alive else describe_cut(None),
            "volume": volume_level(volume) if isinstance(volume, (int, float)) else user["volume"],
            "muted": bool(props.get("ao-mute")),
            "error": self.error,
            "loggedIn": self.logged_in,
            "last": user["last"],
        }

    def write_status(self):
        with self.status_lock:
            status = self.status()
            if status != self.last_status:
                write_json(STATUS_FILE, status, mode=0o644)
                self.last_status = status

    # -- control dispatch

    def handle_command(self, request):
        self.last_activity = time.time()
        command = request.get("cmd")
        if command == "ping":
            return {"ok": True}
        if command == "status":
            return self.status()
        if command == "channels":
            return {"channels": self.channels(refresh=bool(request.get("refresh")))}
        if command == "play":
            return {"channel": self.play(request.get("id", ""))}
        if command == "stop":
            self.stop()
            return {"ok": True}
        if command == "toggle":
            self.toggle()
            return {"ok": True}
        if command in ("next", "prev"):
            self.step(1 if command == "next" else -1)
            return {"ok": True}
        if command == "volume":
            return {"volume": self.set_volume(request.get("value", DEFAULT_VOLUME))}
        if command == "widget":
            log("widget", request.get("state"))
            if request.get("state") == "gone":
                self.widget_gone_at = time.time()
            else:
                self.widget_alive_at = time.time()
            return {"ok": True}
        if command == "relogin":
            self.api.reset(keep_device=True)
            self.logged_in = True
            self.error = ""
            self.write_status()
            return {"ok": True}
        if command == "raw":
            what = request.get("what")
            if what == "lineup":
                return self.api.lineup()
            channel = self.find_channel(request.get("id", ""))
            if what == "tune":
                return self.api.tune(channel["id"], channel["type"])
            if what == "live":
                return self.api.live_update(channel["id"])
            raise SxmError("raw: expected lineup, tune or live")
        if command == "quit":
            threading.Thread(target=self.quit, daemon=True).start()
            return {"ok": True}
        raise SxmError(f"Unknown command {command!r}")

    def quit(self):
        self.mpv.quit()
        self.shutdown.set()

    # -- lifecycle

    def watch_volume(self):
        """mpv never re-reads the stream volume on its own, so changes made in
        Omarchy's audio panel (or wpctl) would go unseen without polling."""
        while not self.shutdown.wait(1):
            if self.widget_gone_at > self.widget_alive_at and time.time() - self.widget_gone_at > 5:
                # The bar widget was removed (plugin disabled) and no reload
                # brought it back: stop playing instead of lingering unseen.
                log("bar widget gone; stopping")
                self.quit()
                return
            if not self.mpv.alive():
                continue
            try:
                linear = self.mpv.command("get_property", "ao-volume", timeout=2)
            except SxmError:
                continue  # audio output not open yet
            if not self.ao_ready:
                # Output just opened: impose the saved level rather than
                # adopting whatever the stream started at.
                self.ao_ready = True
                self._apply_saved_volume()
                continue
            with self.volume_lock:
                # Readings right after our own change can predate it.
                if time.time() - self.volume_set_at < 2:
                    continue
                if not isinstance(linear, (int, float)) or abs(linear - (self.mpv.props.get("ao-volume") or -1)) <= 0.01:
                    continue
                self.mpv.props["ao-volume"] = linear
            self._mpv_changed("ao-volume")

    def background(self):
        while not self.shutdown.wait(10):
            try:
                if self.mpv.alive():
                    self.last_activity = time.time()
                    self.refresh_now_playing()
                elif time.time() - self.last_activity > IDLE_EXIT:
                    log("idle; exiting")
                    self.shutdown.set()
                self.write_status()
            except Exception as error:  # keep the loop alive no matter what
                log("background:", error)

    def serve(self):
        ensure_dirs()
        lock = open(DAEMON_LOCK, "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SxmError("sxm daemon is already running") from None
        kill_strays()
        server = ProxyServer(("127.0.0.1", 0), ProxyHandler)
        server.daemon_ref = self
        self.port = server.server_address[1]
        write_json(DAEMON_FILE, {"port": self.port, "token": self.token, "pid": os.getpid()})
        if threading.current_thread() is threading.main_thread():
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, lambda *_: self.shutdown.set())
        threading.Thread(target=server.serve_forever, daemon=True).start()
        threading.Thread(target=self.background, daemon=True).start()
        threading.Thread(target=self.watch_volume, daemon=True).start()
        log(f"listening on 127.0.0.1:{self.port}")
        self.write_status()
        try:
            self.shutdown.wait()
        finally:
            self.mpv.quit()
            server.shutdown()
            try:
                if (read_json(DAEMON_FILE, {}) or {}).get("pid") == os.getpid():
                    os.unlink(DAEMON_FILE)
            except OSError:
                pass
            write_json(STATUS_FILE, offline_status(), mode=0o644)


class ProxyServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class ProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "sxm"

    def log_message(self, fmt, *args):
        if os.environ.get("SXM_DEBUG"):
            log("http", fmt % args)

    def _reply(self, status, body=b"", content_type="application/json"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _json(self, status, value):
        self._reply(status, json.dumps(value, ensure_ascii=False).encode())

    def _route(self):
        daemon = self.server.daemon_ref
        parts = urllib.parse.urlsplit(self.path)
        prefix = f"/{daemon.token}/"
        if not parts.path.startswith(prefix):
            return None, None, None
        return daemon, parts.path[len(prefix):], urllib.parse.parse_qs(parts.query)

    def do_GET(self):
        daemon, route, query = self._route()
        if daemon is None:
            self._reply(404, b"not found", "text/plain")
            return
        try:
            if route.startswith("live/") and route.endswith(".m3u8"):
                text = daemon.playlist(route[5:-5])
                self._reply(200, text.encode(), "application/vnd.apple.mpegurl")
            elif route.startswith("key/"):
                self._reply(200, daemon.key(route[4:]), "application/octet-stream")
            elif route == "seg":
                self._segment(daemon, (query.get("u") or [""])[0])
            else:
                self._reply(404, b"not found", "text/plain")
        except SxmError as error:
            log("GET", route.split("?")[0][:60], "->", error)
            daemon.error = str(error)
            self._reply(502, str(error).encode(), "text/plain")
        except (BrokenPipeError, ConnectionResetError):
            pass

    do_HEAD = do_GET

    def _segment(self, daemon, url):
        entry = daemon.segment_allowed(url)
        if entry is False:
            self._reply(403, b"segment not issued by this proxy", "text/plain")
            return
        for attempt in range(2):
            try:
                status, headers, data = http_request("GET", url, {"User-Agent": USER_AGENT})
            except SxmError:
                if attempt:
                    raise
                continue
            if status == 200 or status in (403, 404, 410):
                break
        if status != 200:
            self._reply(status, b"", "text/plain")
            return
        daemon.note_segment(entry)
        self._reply(200, data, headers.get("Content-Type") or "application/octet-stream")

    def do_POST(self):
        daemon, route, _ = self._route()
        if daemon is None or route != "cmd":
            self._reply(404, b"not found", "text/plain")
            return
        length = int(self.headers.get("Content-Length") or 0)
        try:
            request = json.loads(self.rfile.read(min(length, 65536)) or b"{}")
            self._json(200, daemon.handle_command(request))
        except SxmError as error:
            if isinstance(error, AuthError):
                daemon.error = str(error)
                daemon.logged_in = Keyring.load() is not None
                daemon.write_status()
            self._json(400, {"error": str(error), "auth": isinstance(error, AuthError)})
        except ValueError:
            self._json(400, {"error": "invalid request"})
        except Exception as error:
            log("command failed:", repr(error))
            self._json(500, {"error": f"internal error: {error}"})


